# Local authentication test server. Copy to .env; never commit real credentials.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit local testing option: enrol inside a normal desktop browser.
DEVICE_SETUP_ALLOW_BROWSER=1
# Keep real authentication on; the fixture preview helper enables its own bypass.
ENABLE_DEV_BRANCH_SCOPE=0
# Optional: show the public homepage on localhost instead of the app locally.
# MARKETING_PREVIEW=1
# Optional: replace the bundled commercial with a cloud-hosted MP4 later.
# MARKETING_VIDEO_URL=https://your-storage.example/washday-commercial.mp4
# Optional: supply a stable, generated local Django secret.
# DJANGO_SECRET_KEY=
# Optional: isolate this local dataset (absolute path).
# SQLITE_PATH=/absolute/path/to/washday-auth.sqlite3

# Cloud production: set these in Openship project variables, not this local file.
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=app.washdayph.com,washdayph.com,www.washdayph.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.washdayph.com,https://washdayph.com,https://www.washdayph.com
# PGDATABASE=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# See docs/openship-deployment.md for the full deployment and OAuth setup.
