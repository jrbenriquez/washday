# Local authentication test server. Copy to .env; never commit real credentials.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit local testing option: enrol inside a normal desktop browser.
DEVICE_SETUP_ALLOW_BROWSER=1
# Keep real authentication on; the fixture preview helper enables its own bypass.
ENABLE_DEV_BRANCH_SCOPE=0
# Optional: supply a stable, generated local Django secret.
# DJANGO_SECRET_KEY=
# Optional: isolate this local dataset (absolute path).
# SQLITE_PATH=/absolute/path/to/washday-auth.sqlite3

# Scheduled Google Drive exports (see docs/google-drive-exports.md).
# Drive client defaults to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET if omitted.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/owner/drive-exports/callback/
# Generate once: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GOOGLE_DRIVE_TOKEN_KEY=
# Optional for existing-folder selection; not needed to create a new folder.
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_APP_ID=
